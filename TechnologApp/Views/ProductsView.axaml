<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TechnologApp.ViewModels"
             x:Class="TechnologApp.Views.ProductsView"
             x:DataType="vm:ProductsViewModel"
             x:CompileBindings="True">


    <DockPanel>
        <!-- Верхняя панель инструментов -->
        <Border DockPanel.Dock="Top" Background="#F0F3F5" Padding="12,10">
            <DockPanel>
                <!-- Кнопки справа -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="➕ Добавить" Command="{Binding AddCommand}"
                            IsEnabled="{Binding !IsLoading}" Width="100"/>
                    <Button Content="📊 Экспорт" Command="{Binding ExportCommand}"
                            IsEnabled="{Binding !IsLoading}" Width="100"/>
                    <Button Content="🔄 Обновить" Command="{Binding LoadCommand}" Width="100"/>
                </StackPanel>

                <!-- Поиск и статус слева -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox Text="{Binding SearchText}" Watermark="🔍 Поиск..." Width="250"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                               Foreground="#6C757D" FontSize="13"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Таблица данных -->
        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding idProduct}" Width="60"/>
                <DataGridTextColumn Header="Код" Binding="{Binding code}" Width="100"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding nameProduct}" Width="250"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding type}" Width="120"/>
                <DataGridTextColumn Header="Форма" Binding="{Binding form}" Width="120"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="110"/>

                <!-- Кнопки действий -->
                <DataGridTemplateColumn Header="Действия" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5">

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>